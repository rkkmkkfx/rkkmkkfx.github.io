---
const archive = [
  { src: '/static/img/work/sattelecom.jpg', label: 'signal / 2017', alt: 'Stacked televisions in a field' },
  { src: '/static/img/work/volna.jpg', label: 'kept / 2016', alt: 'Volna Baikala brand mark' },
  { src: '/static/img/work/1k-irk.jpg', label: 'built / 2017', alt: '1K Irk project image' },
  { src: '/static/img/work/plastic.jpg', label: 'learned / 2015', alt: 'Plastic Angarsk project image' },
];
---
<section class="archive container rule" aria-labelledby="archive-title">
  <div class="archive-head"><p class="eyebrow" id="archive-title">03 / Personal archive</p><span class="archive-code">rkkmkkfx / memory lane</span></div>
  <p class="archive-intro">Before the systems had names, there were strange little sites, borrowed images, and the stubborn decision to keep learning.</p>
  <div class="archive-grid">
    {archive.map((item, index) => <figure class:list={{ [`archive-item-${index + 1}`]: true }}><div class="archive-image"><img src={item.src} alt={item.alt} loading="lazy" /></div><figcaption><span>{item.label}</span><span>0{index + 1}</span></figcaption></figure>)}
  </div>
</section>
<style>
  .archive { padding-block: 5rem 7rem; overflow: hidden; }
  .archive-head { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
  .archive-code { color: var(--signal); font: .65rem var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  .archive-intro { max-width: 38rem; margin: 2rem 0 3rem; color: var(--fog); font-size: 1.25rem; line-height: 1.5; }
  .archive-grid { display: grid; grid-template-columns: 1.35fr .8fr .7fr 1fr; gap: .75rem; align-items: end; }
  figure { margin: 0; } .archive-image { position: relative; aspect-ratio: 1.2; overflow: hidden; background: var(--surface); filter: grayscale(1) contrast(1.15); transition: filter .5s ease, transform .5s var(--ease); }
  figure:nth-child(even) .archive-image { aspect-ratio: .85; transform: rotate(1.5deg); } figure:nth-child(3) .archive-image { transform: rotate(-2deg); }
  figure:hover .archive-image { filter: grayscale(0) contrast(1); transform: rotate(0) scale(1.04); } .archive-image img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: screen; opacity: .8; }
  figcaption { display: flex; justify-content: space-between; padding-top: .6rem; color: var(--fog); font: .6rem var(--mono); text-transform: uppercase; } figcaption span:first-child { color: var(--paper); }
  @media(max-width:700px){ .archive-grid{grid-template-columns:repeat(2,1fr)} .archive-item-2 .archive-image,.archive-item-3 .archive-image{aspect-ratio:1} }
</style>
