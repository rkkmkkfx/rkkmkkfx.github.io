---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title?: string; description?: string; }
const { title = 'Sergey Baranov — Senior web developer', description = 'A senior web developer turning complex systems into clear, useful products.' } = Astro.props;
const site = Astro.site ?? new URL('https://rkkmkkfx.dev');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/static/img/generated/play-stage-v2.png', site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sergey Baranov',
  alternateName: 'rkkmkkfx',
  jobTitle: 'Senior Web Developer',
  url: 'https://rkkmkkfx.dev/',
  email: 'mailto:hello@rkkmkkfx.dev',
  knowsAbout: ['UI architecture', 'Rendering systems', 'Data interfaces', 'Browser runtime', 'Developer tooling'],
  sameAs: ['https://github.com/rkkmkkfx', 'https://www.linkedin.com/in/rkkmkkfx/'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090c" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/static/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/static/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/static/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/static/favicon/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sergey Baranov" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <span class="scroll-progress" aria-hidden="true"></span>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
  </body>
</html>
<script is:inline>
  const root = document.documentElement;
  const reveals = document.querySelectorAll('[data-reveal]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced) reveals.forEach((el) => el.classList.add('is-visible'));
  else {
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
      if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
    }), { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    reveals.forEach((el) => observer.observe(el));
  }
  let raf = 0;
  const phases = [
    { key: 'boot', label: 'BOOT', description: 'loading intent' },
    { key: 'map', label: 'MAP', description: 'shaping the system' },
    { key: 'work', label: 'WORK', description: 'making it useful' },
    { key: 'shipped', label: 'SHIPPED', description: 'in the hands of people' },
  ];
  const setPhase = (progress) => {
    const phase = phases[Math.min(phases.length - 1, Math.floor(progress * phases.length))];
    document.body.dataset.phase = phase.key;
    document.querySelectorAll('[data-phase-label]').forEach((el) => { el.textContent = phase.label; });
    document.querySelectorAll('[data-phase-description]').forEach((el) => { el.textContent = phase.description; });
    document.querySelectorAll('[data-system-map]').forEach((el) => { el.dataset.phase = phase.key; });
    document.dispatchEvent(new CustomEvent('portfolio:phase', { detail: phase.key }));
  };
  const updateScroll = () => {
    raf = 0;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const progress = max > 0 ? window.scrollY / max : 0;
    root.style.setProperty('--scroll-progress', progress.toFixed(3));
    setPhase(progress);
    document.querySelectorAll('[data-parallax]').forEach((el) => {
      const box = el.getBoundingClientRect();
      const amount = Math.max(-1, Math.min(1, (window.innerHeight / 2 - (box.top + box.height / 2)) / window.innerHeight));
      el.style.setProperty('--parallax-y', `${(amount * 22).toFixed(1)}px`);
    });
  };
  window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(updateScroll); }, { passive: true });
  updateScroll();
  document.querySelector('[data-chaos-toggle]')?.addEventListener('click', () => {
    document.body.toggleAttribute('data-chaos');
    document.querySelector('[data-chaos-toggle]')?.setAttribute('aria-pressed', document.body.hasAttribute('data-chaos') ? 'true' : 'false');
  });
</script>
<style>
  .skip-link { position: fixed; left: 1rem; top: -5rem; z-index: 20; padding: .7rem 1rem; background: var(--signal); color: var(--ink); font: .75rem var(--mono); }
  .skip-link:focus { top: 1rem; }
</style>
