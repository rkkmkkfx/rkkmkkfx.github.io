---
import BaseLayout from '../layouts/BaseLayout.astro';
import SystemMap from '../components/SystemMap.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';
const work = (await getCollection('work')).sort((a, b) => b.data.year - a.data.year);
const lab = (await getCollection('lab')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---
<BaseLayout>
  <section class="hero container">
    <div class="hero-copy"><p class="eyebrow" data-reveal style="--delay: 100ms">Senior web developer / based in Siberia</p><h1 class="display" data-reveal style="--delay: 220ms">I turn complex systems into <em>clear</em>, useful products.</h1><p class="intro" data-reveal style="--delay: 380ms">From first idea to final interface, I help teams make ambitious digital work feel simple to use and hard to forget.</p><div class="actions" data-reveal style="--delay: 520ms"><a class="button button--solid" href="/work/">See selected work</a><a class="text-link" href="/about/">How I work <span>↓</span></a></div></div>
    <div data-reveal style="--delay: 340ms"><SystemMap /></div>
  </section>
  <section class="proof container rule"><div class="proof-label eyebrow">The useful middle</div><div class="proof-copy"><p>I work where product thinking meets frontend craft: translating fuzzy intent into systems people can actually navigate.</p><div class="capabilities"><span>Product interfaces</span><span>Frontend systems</span><span>Technical direction</span></div></div></section>
  <section class="section container"><div class="section-head"><p class="eyebrow">01 / Selected work</p><a class="text-link" href="/work/">View all <span>↗</span></a></div><div class="work-grid">{work.slice(0, 3).map((entry) => <WorkCard entry={entry} />)}</div></section>
  <section class="lab-spotlight container rule"><div><p class="eyebrow">02 / From the lab</p><h2 class="display">Thinking in public,<br /><em>building in private.</em></h2></div><div><p>{lab?.data.summary}</p><a class="button" href={`/lab/${lab?.id}/`}>Read the latest note</a></div></section>
  <section class="closing container"><p class="eyebrow">Have a difficult thing to make clear?</p><h2 class="display">Let’s build the<br /><em>next useful thing.</em></h2><a class="button button--solid" href="/contact/">Start a conversation</a></section>
</BaseLayout>
<style>
  .hero { display: grid; grid-template-columns: minmax(0, .95fr) minmax(25rem, 1.05fr); gap: clamp(2rem, 7vw, 8rem); align-items: center; min-height: calc(100vh - 5.5rem); padding-block: 5rem 7rem; }
  h1 { max-width: 12ch; margin: 1.4rem 0 1.8rem; font-size: clamp(4rem, 8.5vw, 9.2rem); line-height: .84; } em { color: var(--signal); font-style: normal; } .intro { max-width: 30rem; color: var(--fog); font-size: 1rem; line-height: 1.7; } .actions { display: flex; align-items: center; gap: 1.5rem; margin-top: 2.25rem; }
  .text-link { display: inline-flex; gap: .7rem; align-items: center; color: var(--fog); font: .72rem var(--mono); text-transform: uppercase; letter-spacing: .05em; } .text-link span { color: var(--signal); font-size: 1rem; }
  .proof { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; padding-block: 2.5rem; } .proof-copy { display: grid; grid-template-columns: minmax(0, 1fr) minmax(12rem, .7fr); gap: 3rem; } .proof-copy p, .lab-spotlight p { max-width: 34rem; margin: 0; font-size: 1.2rem; line-height: 1.5; } .capabilities { display: grid; gap: .7rem; color: var(--fog); font: .7rem var(--mono); text-transform: uppercase; }
  .section { padding-block: 8rem; } .section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2.5rem; } .work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .lab-spotlight { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; padding-block: 5rem; } .lab-spotlight h2, .closing h2 { margin: 1.5rem 0 2rem; font-size: clamp(3rem, 6vw, 6rem); line-height: .85; } .lab-spotlight .button { margin-top: 2rem; }
  .closing { padding-block: 9rem 12rem; } .closing h2 { max-width: 8ch; }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 4rem; } .hero-copy { order: 0; } .system-map { min-height: 22rem; } .work-grid { grid-template-columns: 1fr; max-width: 45rem; } .proof, .proof-copy, .lab-spotlight { grid-template-columns: 1fr; } .section { padding-block: 5rem; } }
  @media (max-width: 500px) { h1 { font-size: 4rem; } .actions { align-items: flex-start; flex-direction: column; } }
</style>
