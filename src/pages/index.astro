---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlayDeck from '../components/PlayDeck.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';
const work = (await getCollection('work')).sort((a, b) => b.data.year - a.data.year);
const lab = (await getCollection('lab')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout>
  <section class="hero container">
    <div class="hero-stage" aria-hidden="true"><img src="/static/img/generated/play-stage-v2.png" alt="" /></div>
    <span class="personal-stamp" aria-hidden="true">rkkmkkfx<br /><small>side a / 2026</small></span>
    <div class="hero-copy"><div class="hero-kicker eyebrow" data-reveal style="--delay: 100ms"><span>PLAYABLE SET / 001</span><span>web developer / dj / player</span></div><h1 class="display" data-reveal style="--delay: 220ms">I build interfaces that <em>hit</em> the right signal.</h1><p class="intro" data-reveal style="--delay: 380ms">Frontend systems, product thinking, and a taste for the moment when complexity suddenly becomes playable.</p><div class="actions" data-reveal style="--delay: 520ms"><a class="button button--solid" href="/work/">Open tracklist</a><a class="text-link" href="/about/">About the player <span>↓</span></a></div></div>
    <div class="hero-visual" data-reveal style="--delay: 340ms"><PlayDeck /></div>
  </section>
  <section class="proof container rule" data-parallax><div class="proof-label eyebrow">The useful middle</div><div class="proof-copy"><p>I work where product thinking meets frontend craft: translating fuzzy intent into systems people can actually navigate.</p><div class="capabilities"><span>Product interfaces</span><span>Frontend systems</span><span>Technical direction</span></div></div></section>
  <section class="section container"><div class="section-head"><p class="eyebrow">TRACKLIST / SIDE A</p><a class="text-link" href="/work/">Open all tracks <span>↗</span></a></div><div class="work-grid">{work.slice(0, 3).map((entry) => <WorkCard entry={entry} />)}</div></section>
  <section class="lab-spotlight container rule"><div class="lab-heading"><p class="eyebrow">B-SIDES / FROM THE LAB</p><h2 class="display">Thinking in public,<br /><em>building in private.</em></h2><a class="text-link" href="/lab/">Open all B-Sides <span>↗</span></a></div><div class="lab-list">{lab.map((entry, index) => <a class="lab-track" href={`/lab/${entry.id}/`} data-reveal style={`--delay:${index * 90}ms`}><div class="lab-track-top"><span class="lab-number">0{index + 1}</span><span class="lab-rule"></span><span class="eyebrow">{entry.data.status}</span></div><h3>{entry.data.title}</h3><p>{entry.data.summary}</p><div class="lab-track-meta"><span>{entry.data.tags.join(' / ')}</span><time>{entry.data.date.toLocaleDateString('en-US', {year:'numeric', month:'short'})}</time></div></a>)}</div></section>
  <section class="closing container"><p class="eyebrow">Have a difficult thing to make clear?</p><h2 class="display">Let’s build the<br /><em>next useful thing.</em></h2><a class="button button--solid" href="/contact/">Start a conversation</a></section>
</BaseLayout>
<style>
  .hero { position: relative; display: grid; grid-template-columns: minmax(0, .9fr) minmax(25rem, 1.1fr); grid-template-areas: 'copy visual'; gap: clamp(2rem, 7vw, 8rem); align-items: center; min-height: calc(100svh - 5.5rem); padding-block: 5rem 0; }
  .hero > .hero-copy, .hero > .hero-visual { position: relative; z-index: 1; }
  .hero-stage { position: absolute; z-index: 0; inset: 0 -8vw; overflow: hidden; pointer-events: none; opacity: .62; mask-image: linear-gradient(90deg, transparent, black 16%, black 84%, transparent); }
  .hero-stage::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--ink) 0%, transparent 30%, rgba(9,10,15,.12) 72%, var(--ink) 100%), linear-gradient(0deg, var(--ink) 0%, transparent 25%, transparent 82%, var(--ink) 100%); }
  .hero-stage img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.95) contrast(1.05); transform: scale(1.04); }
  .hero::before { content: 'A-SIDE / OPEN SESSION'; position: absolute; top: 1.25rem; left: 0; color: var(--console-blue); font: .62rem var(--mono); letter-spacing: .1em; }
  .hero::after { content: ''; position: absolute; top: 2.1rem; left: 0; right: 0; border-top: 1px solid var(--rule); opacity: .65; }
  .hero-copy { grid-area: copy; padding-top: 0; translate: 0 -2.5rem; }
  .hero-kicker { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--rule); color: var(--club-pink); font-size: .58rem; letter-spacing: .08em; }
  .hero-kicker span:last-child { color: var(--muted); text-align: right; }
  .hero-visual { grid-area: visual; align-self: center; translate: 0 -2.5rem; }
  .personal-stamp { position: absolute; top: 5rem; right: clamp(1rem, 2vw, 2rem); color: var(--signal); font: 700 clamp(.8rem, 1.5vw, 1.2rem)/.8 var(--mono); letter-spacing: -.1em; transform: rotate(-8deg); opacity: .75; } .personal-stamp small { color: var(--fog); font: .5rem var(--mono); letter-spacing: .02em; }
  h1 { max-width: 10ch; margin: 1.4rem 0 1.8rem; font-size: clamp(4rem, 8.5vw, 9.2rem); line-height: .84; } em { color: var(--club-pink); font-style: normal; } .intro { max-width: 30rem; color: var(--fog); font-size: 1rem; line-height: 1.7; } .actions { display: flex; align-items: center; gap: 1.5rem; margin-top: 2.25rem; }
  .text-link { display: inline-flex; gap: .7rem; align-items: center; color: var(--fog); font: .72rem var(--mono); text-transform: uppercase; letter-spacing: .05em; } .text-link span { color: var(--signal); font-size: 1rem; }
  .proof { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; padding-block: 2.5rem; } .proof-copy { display: grid; grid-template-columns: minmax(0, 1fr) minmax(12rem, .7fr); gap: 3rem; } .proof-copy p, .lab-spotlight p { max-width: 34rem; margin: 0; font-size: 1.2rem; line-height: 1.5; } .capabilities { display: grid; gap: .7rem; color: var(--fog); font: .7rem var(--mono); text-transform: uppercase; } .capabilities span { transition: color .3s ease, transform .5s var(--ease); } .capabilities span:hover { color: var(--signal); transform: translateX(.5rem); }
  .section { padding-block: 8rem; } .section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2.5rem; } .work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .lab-spotlight{display:grid;grid-template-columns:1fr 1.15fr;gap:clamp(2rem,6vw,6rem);padding-block:5rem}.lab-heading h2,.closing h2{margin:1.5rem 0 2rem;font-size:clamp(3rem,6vw,6rem);line-height:.85}.lab-heading>.text-link{margin-top:2rem}.lab-list{display:grid;gap:1rem}.lab-track{display:block;padding:1.2rem;border:1px solid var(--rule);background:rgba(16,18,29,.55);transition:border-color .3s var(--ease),transform .4s var(--ease),background .3s var(--ease)}.lab-track:hover{border-color:var(--signal);background:rgba(255,79,216,.06);transform:translateX(.5rem)}.lab-track-top{display:flex;align-items:center;gap:.7rem}.lab-number{color:var(--signal);font:.7rem var(--mono)}.lab-rule{height:1px;flex:1;background:var(--rule)}.lab-track h3{margin:1rem 0 .6rem;font:600 clamp(1.5rem,2.5vw,2.5rem)/.9 var(--display);letter-spacing:-.035em}.lab-track p{margin:0;color:var(--fog);font-size:.85rem;line-height:1.5}.lab-track-meta{display:flex;justify-content:space-between;gap:1rem;margin-top:1.3rem;color:var(--current);font:.58rem var(--mono);letter-spacing:.04em;text-transform:uppercase}.lab-track-meta time{color:var(--fog)}
  .closing { padding-block: 9rem 12rem; } .closing h2 { max-width: 8ch; }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; grid-template-areas: 'copy' 'visual'; min-height: auto; padding-top: 4rem; padding-bottom: 4rem; } .hero-copy { padding-top: 2rem; translate: none; } .hero-kicker { max-width: 38rem; } .hero-visual { align-self: auto; translate: none; } .work-grid { grid-template-columns: 1fr; max-width: 45rem; } .proof, .proof-copy, .lab-spotlight { grid-template-columns: 1fr; } .section { padding-block: 5rem; } }
  @media (max-width: 500px) { h1 { font-size: 4rem; } .actions { align-items: flex-start; flex-direction: column; } .personal-stamp { top: 2rem; left: auto; right: 1rem; } .hero-stage { inset: 0 -25vw; opacity: .42; } }
</style>
