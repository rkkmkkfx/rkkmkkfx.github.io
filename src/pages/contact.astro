---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Sergey Baranov" description="Reach Sergey Baranov — frontend web developer at AnyChart. Email, GitHub, LinkedIn, Telegram, and SoundCloud.">
  <section class="contact container">
    <p class="eyebrow">A good place to start</p>
    <h1 class="display">Tell me what<br /><em>needs building.</em></h1>
    <p class="lead">I’m interested in thoughtful products, difficult interfaces, and teams who care about the details.</p>
    <a class="email" href="mailto:hello@rkkmkkfx.dev">hello@rkkmkkfx.dev <span>↗</span></a>
    <div class="links">
      <a href="https://github.com/rkkmkkfx">GitHub ↗</a>
      <a href="https://www.linkedin.com/in/rkkmkkfx/">LinkedIn ↗</a>
      <a href="https://t.me/rkkmkkfx">Telegram ↗</a>
      <a href="https://soundcloud.com/martianskymusic">SoundCloud ↗</a>
      <span class="hours">Armenia / UTC+4</span>
    </div>
  </section>
</BaseLayout>
<style>
 .contact { padding-block: 10rem 14rem; } h1 { margin: 1.5rem 0 2rem; font-size: clamp(4.5rem, 11vw, 11rem); line-height: .8; } .lead { max-width: 30rem; color: var(--fog); font-size: 1.1rem; line-height: 1.6; } .email { display: inline-block; margin-top: 3rem; border-bottom: 1px solid var(--signal); padding-bottom: .5rem; font: 1.2rem var(--mono); } .email span { color: var(--signal); } .links { display: flex; flex-wrap: wrap; align-items: center; gap: 2rem; margin-top: 6rem; color: var(--fog); font: .75rem var(--mono); text-transform: uppercase; } .links .hours { color: var(--current); }
</style>
