---
import { getCollection, render } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths(){ const entries = await getCollection('work'); return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props; const { Content } = await render(entry); const { data } = entry;
---
<BaseLayout title={`${data.title} — Sergey Baranov`}><article class="case container"><a class="back" href="/work/">← All work</a><header><p class="eyebrow">{data.year} / {data.role}</p><h1 class="display">{data.title}</h1><p class="summary">{data.summary}</p><a class="button button--solid" href={data.url}>Visit project</a></header><div class="hero-image"><img src={data.image} alt={`${data.title} project preview`} /></div><div class="body"><div class="meta"><span class="eyebrow">Outcome</span><p>{data.outcome}</p><div class="tags">{data.tags.map((tag)=><span>{tag}</span>)}</div></div><div class="prose"><Content /></div></div></article></BaseLayout>
<style>
 .case{padding-block:3rem 10rem}.back{display:inline-block;margin-bottom:6rem;color:var(--fog);font:.7rem var(--mono);text-transform:uppercase}.case header{max-width:60rem}.case h1{margin:1.5rem 0;font-size:clamp(5rem,14vw,14rem);line-height:.75}.summary{max-width:35rem;color:var(--fog);font-size:1.15rem;line-height:1.6;margin:2rem 0}.hero-image{margin:6rem 0 5rem;aspect-ratio:16/8;overflow:hidden;background:var(--surface)}.hero-image img{width:100%;height:100%;object-fit:cover}.body{display:grid;grid-template-columns:1fr 2fr;gap:4rem;border-top:1px solid var(--rule);padding-top:2rem}.meta p{max-width:18rem;line-height:1.6}.tags{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:2rem}.tags span{border:1px solid var(--rule);padding:.4rem .5rem;color:var(--fog);font:.6rem var(--mono)}.prose{max-width:42rem;font-size:1.1rem;line-height:1.8}.prose h2{margin-top:0;color:var(--paper);font:600 2.5rem/.95 var(--display)}.prose p{color:var(--fog)}@media(max-width:700px){.case{padding-top:2rem}.back{margin-bottom:4rem}.body{grid-template-columns:1fr;gap:2rem}.hero-image{margin-block:4rem 3rem}}
</style>
