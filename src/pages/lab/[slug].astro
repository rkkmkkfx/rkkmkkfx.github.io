---
import { getCollection, render } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths(){ const entries=await getCollection('lab'); return entries.map((entry)=>({params:{slug:entry.id},props:{entry}})); }
const {entry}=Astro.props; const {Content}=await render(entry);
---
<BaseLayout title={`${entry.data.title} — Lab`}><article class="note container"><a class="back" href="/lab/">← Back to lab</a><p class="eyebrow">{entry.data.status} / {entry.data.date.toLocaleDateString('en-US', {year:'numeric', month:'long', day:'numeric'})}</p><h1 class="display">{entry.data.title}</h1><div class="prose"><Content /></div></article></BaseLayout>
<style>
 .note{padding-block:3rem 12rem}.back{display:inline-block;margin-bottom:6rem;color:var(--fog);font:.7rem var(--mono);text-transform:uppercase}.note h1{max-width:15ch;margin:1.5rem 0 6rem;font-size:clamp(4rem,10vw,10rem);line-height:.8}.prose{max-width:45rem;font-size:1.25rem;line-height:1.75}.prose p{color:var(--fog)}.prose :global(a:not(.note-link)){color:var(--signal);font-weight:600;text-decoration:none;transition:color .25s var(--ease), text-decoration-color .25s var(--ease)}.prose :global(a:not(.note-link)):hover{color:var(--paper);text-decoration:underline;text-decoration-color:var(--paper);text-decoration-thickness:2px;text-underline-offset:.18em}.prose :global(.note-link){display:inline-block;margin-top:2rem;color:var(--signal);font:.75rem var(--mono);text-transform:uppercase}.prose :global(.note-link):hover{color:var(--paper);text-underline-offset:.18em;text-decoration:underline}.prose :global(.repo-game){width:min(100%,722px);margin:3.5rem auto;border:1px solid var(--signal);box-shadow:12px 12px 0 rgba(255,79,216,.14);background:#090a0f}.prose :global(.repo-game) :global(iframe){display:block;width:100%;height:clamp(30rem,58vw,46rem);border:0}@media(max-width:700px){.note{padding-block:2rem 8rem}.back{margin-bottom:4rem}.note h1{margin-bottom:4rem}}
</style>
