---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getCollection } from 'astro:content';
const entries = (await getCollection('lab')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Lab — Sergey Baranov"><section class="intro container"><p class="eyebrow">02 / The lab</p><h1 class="display">Notes from<br /><em>the useful edge.</em></h1><p>A running record of experiments, questions, and small systems that help me understand how the web can work better.</p></section><section class="entries container">{entries.map((entry, index) => <a class={`entry entry--${entry.id}`} href={`/lab/${entry.id}/`} data-reveal style={`--delay:${index * 90}ms`}><div><span class="eyebrow">{entry.data.status}</span><h2 class="display">{entry.data.title}</h2></div><div><time>{entry.data.date.toLocaleDateString('en-US', {year:'numeric', month:'short'})}</time><p>{entry.data.summary}</p><div class="entry-foot"><span class="tags">{entry.data.tags.join(' / ')}</span><span class="read">Read note ↗</span></div></div></a>)}</section></BaseLayout>
<style>
 .intro{padding-block:8rem 5rem}.intro h1{margin:1.5rem 0;font-size:clamp(4rem,10vw,10rem);line-height:.82}.intro>p:last-child{max-width:32rem;color:var(--fog);line-height:1.7}.entries{padding-bottom:10rem}.entry{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:2rem;padding-block:2.5rem;border-top:1px solid var(--rule);transition:padding .45s var(--ease), border-color .45s var(--ease)}.entry::before{content:'';position:absolute;top:-1px;left:0;width:clamp(3rem,8vw,8rem);height:1px;background:var(--signal);transform:scaleX(0);transform-origin:left;transition:transform .45s var(--ease)}.entry:hover{padding-inline:1rem;border-color:color-mix(in srgb, var(--signal) 45%, var(--rule))}.entry:hover::before{transform:scaleX(1)}.entry h2{margin:1rem 0;font-size:clamp(2.5rem,5vw,5rem);line-height:.85;transition:color .3s var(--ease)}.entry:hover h2{color:var(--signal)}.entry--canvas-side-quest:hover h2{color:var(--arcade-green)}.entry time,.entry p{color:var(--fog);font:.75rem var(--mono)}.entry p{max-width:25rem;line-height:1.6;font-family:var(--body);font-size:.9rem}.entry-foot{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}.tags{color:var(--current);font:.6rem var(--mono);letter-spacing:.08em;text-transform:uppercase}.read{display:inline-block;margin-top:1rem;color:var(--signal);font:.7rem var(--mono);text-transform:uppercase}.note-link{display:inline-block;margin-top:2rem;color:var(--signal);font:.75rem var(--mono);text-transform:uppercase}.prose .note-link{font-size:.75rem}@media(max-width:700px){.intro{padding-block:5rem 3rem}.entry{grid-template-columns:1fr;gap:1rem}.entry:hover{padding-inline:0}}
</style>
